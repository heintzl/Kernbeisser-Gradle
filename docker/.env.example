# Copy to docker/.env and adjust. All values are optional; these are the defaults.
# The Makefile reads this file too, so keep the plain KEY=value format (no quotes, no spaces).

MARIADB_VERSION=10.11
DB_NAME=kernbeisser
DB_USER=kernbeisser
DB_PASSWORD=kernbeisser
DB_ROOT_PASSWORD=root

# Published ports. Bound to localhost only; use an SSH tunnel to reach them from elsewhere.
BIND_ADDRESS=127.0.0.1
DB_PORT=3306
NOVNC_PORT=6080
VNC_PORT=5900
DEBUG_PORT=5005
ADMINER_PORT=8081

# Virtual screen of the GUI container (WIDTHxHEIGHTxDEPTH)
SCREEN_GEOMETRY=1600x1000x24

# Uncomment if building the GUI image fails in a RUN step with "permission denied"
# (seen with AppArmor-confined rootless Docker). Uses the classic builder instead of BuildKit.
#DOCKER_BUILDKIT=0
